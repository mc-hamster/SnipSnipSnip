    "Search %@" : {

    },
    "Search clipboard history" : {

    },
    "Search Clipboard History" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search Clipboard History"
          }
        }
      }
    },
    "Search Help" : {

    },
    "Search includes item content, source app, type, collections, link metadata, file paths, and locally recognized text inside images and screenshots. Pinned items appear first, followed by Today, Yesterday, and dated sections. Image and snip cards show large cropped previews; Preview shows the full fitted image. Opaque colors fill their cards with contrasting text, and code and JSON use monospaced text. Narrow results by type, date, source app, or collection. Preview shows a readable full-content view first. Choose Edit Text to edit or transform text, then Done to return to the preview while keeping the draft. Links have an explicit Open Link action, images have a large fitted preview, and files show their availability. Expand Details for the precise copy time, source, size, and stored item count. Choose Add to Collection to select an existing collection or enter a name; remove a membership with the cross beside its name. Reveal in Finder locates a copied file. Text drafts stay with each item as you select other rows or change filters, until you close Clipboard History or disable it. Reset restores the original text for the selected item. Adding an existing collection keeps the item in that collection; use the Remove from action beside its name to take it out. Pin durable favorites for quick access. Open Snip in Editor finds the latest retained version of a screenshot even when it is no longer recent. If its editable history is unavailable, the clipboard copy remains available." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search includes item content, source app, type, collections, link metadata, file paths, and locally recognized text inside images and screenshots. Pinned items appear first, followed by Today, Yesterday, and dated sections. Image and snip cards show large cropped previews; Preview shows the full fitted image. Opaque colors fill their cards with contrasting text, and code and JSON use monospaced text. Narrow results by type, date, source app, or collection. Preview shows a readable full-content view first. Choose Edit Text to edit or transform text, then Done to return to the preview while keeping the draft. Links have an explicit Open Link action, images have a large fitted preview, and files show their availability. Expand Details for the precise copy time, source, size, and stored item count. Choose Add to Collection to select an existing collection or enter a name; remove a membership with the cross beside its name. Reveal in Finder locates a copied file. Text drafts stay with each item as you select other rows or change filters, until you close Clipboard History or disable it. Reset restores the original text for the selected item. Adding an existing collection keeps the item in that collection; use the Remove from action beside its name to take it out. Pin durable favorites for quick access. Open Snip in Editor finds the latest retained version of a screenshot even when it is no longer recent. If its editable history is unavailable, the clipboard copy remains available."
          }
        }
      }
    },
