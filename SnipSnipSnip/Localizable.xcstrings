    "Choose Blur, Pixelate, or Redact." : {

    },
    "Choose Callout, Copy Text, Pick Color, or Insert Image." : {

    },
    "Choose Edit Selected Capture, double-click an item, or press Return to crop and annotate only that source. Done returns to the same goal stage with the item selected. Press Option-Return to adjust framing, then Escape to finish." : {

    },
    "Choose exactly how many included steps appear on each PDF page." : {

