    },
    "Choose a different tool in the %@ group." : {

    },
    "Choose a different utility or insert an image." : {

    },
    "Choose a fixed column count, or let Auto determine it." : {

    },
    "Choose a horizontal or vertical comparison." : {

    },
    "Choose a ready-made shadow style." : {

    },
    "Choose a screenshot and inspect it at any size. It stays editable unless you turn on Use Rendered Image Only." : {

    },
    "Choose a smaller width. Resized output is limited to 32,768 pixels per side and 64 million pixels in total." : {
      "extractionState" : "manual",
      "localizations" : {
