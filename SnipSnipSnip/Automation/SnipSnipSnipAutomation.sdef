<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="SnipSnipSnip Automation">
  <suite name="SnipSnipSnip Automation" code="SSSa" description="Automation commands for SnipSnipSnip screenshots and exports. Commands return JSON text.">
    <command name="automation status" code="SSSaSTAT" description="Return automation capabilities and permission status as JSON.">
      <cocoa class="SSSAutomationStatusCommand"/>
      <result type="text" description="JSON automation result."/>
    </command>
    <command name="list capture presets" code="SSSaLSPR" description="Return capture presets as JSON.">
      <cocoa class="SSSListCapturePresetsCommand"/>
      <result type="text" description="JSON automation result."/>
    </command>
    <command name="run capture preset" code="SSSaRNPR" description="Run a capture preset by id or name.">
      <cocoa class="SSSRunCapturePresetCommand"/>
      <parameter name="id" code="SSid" type="text" optional="yes" description="Preset UUID."/>
      <parameter name="name" code="SSnm" type="text" optional="yes" description="Preset name."/>
      <parameter name="output" code="SSou" type="text" optional="yes" description="editor, clipboard, float, or none."/>
      <parameter name="outputPath" code="SSop" type="text" optional="yes" description="POSIX output path for rendered file or .sss package."/>
      <parameter name="format" code="SSfm" type="text" optional="yes" description="png, jpeg, pdf, or sss."/>
      <parameter name="overwrite" code="SSow" type="boolean" optional="yes" description="Replace an existing file."/>
      <parameter name="privateCapture" code="SSpv" type="boolean" optional="yes" description="Run as Private Capture."/>
      <result type="text" description="JSON automation result."/>
    </command>
    <command name="capture fullscreen" code="SSSaCFUL" description="Capture the configured fullscreen target.">
      <cocoa class="SSSCaptureFullscreenCommand"/>
      <parameter name="display" code="SSds" type="text" optional="yes" description="app-default, current, selected, or all."/>
      <parameter name="output" code="SSou" type="text" optional="yes" description="editor, clipboard, float, or none."/>
      <parameter name="outputPath" code="SSop" type="text" optional="yes" description="POSIX output path for rendered file."/>
      <parameter name="format" code="SSfm" type="text" optional="yes" description="png, jpeg, or pdf."/>
      <parameter name="overwrite" code="SSow" type="boolean" optional="yes" description="Replace an existing file."/>
      <parameter name="privateCapture" code="SSpv" type="boolean" optional="yes" description="Run as Private Capture."/>
      <result type="text" description="JSON automation result."/>
    </command>
    <command name="capture frontmost window" code="SSSaCFRW" description="Capture the frontmost eligible window.">
      <cocoa class="SSSCaptureFrontmostWindowCommand"/>
      <parameter name="output" code="SSou" type="text" optional="yes" description="editor, clipboard, float, or none."/>
      <parameter name="outputPath" code="SSop" type="text" optional="yes" description="POSIX output path for rendered file."/>
      <parameter name="format" code="SSfm" type="text" optional="yes" description="png, jpeg, or pdf."/>
      <parameter name="overwrite" code="SSow" type="boolean" optional="yes" description="Replace an existing file."/>
      <parameter name="privateCapture" code="SSpv" type="boolean" optional="yes" description="Run as Private Capture."/>
      <result type="text" description="JSON automation result."/>
    </command>
    <command name="capture region" code="SSSaCREG" description="Capture a fixed region or start interactive region capture.">
      <cocoa class="SSSCaptureRegionCommand"/>
      <parameter name="rect" code="SSrc" type="text" optional="yes" description="Region rectangle as x,y,width,height in screen points."/>
      <parameter name="interactive" code="SSin" type="boolean" optional="yes" description="Start user-selected region capture."/>
      <parameter name="output" code="SSou" type="text" optional="yes" description="editor, clipboard, float, or none."/>
      <parameter name="outputPath" code="SSop" type="text" optional="yes" description="POSIX output path for rendered file."/>
      <parameter name="format" code="SSfm" type="text" optional="yes" description="png, jpeg, or pdf."/>
      <parameter name="overwrite" code="SSow" type="boolean" optional="yes" description="Replace an existing file."/>
      <parameter name="privateCapture" code="SSpv" type="boolean" optional="yes" description="Run as Private Capture."/>
      <result type="text" description="JSON automation result."/>
    </command>
    <command name="capture window" code="SSSaCWIN" description="Start interactive window capture.">
      <cocoa class="SSSCaptureWindowCommand"/>
      <parameter name="interactive" code="SSin" type="boolean" optional="yes" description="Start user-selected window capture."/>
      <parameter name="output" code="SSou" type="text" optional="yes" description="editor, clipboard, float, or none."/>
      <parameter name="outputPath" code="SSop" type="text" optional="yes" description="POSIX output path for rendered file."/>
      <parameter name="format" code="SSfm" type="text" optional="yes" description="png, jpeg, or pdf."/>
      <parameter name="overwrite" code="SSow" type="boolean" optional="yes" description="Replace an existing file."/>
      <parameter name="privateCapture" code="SSpv" type="boolean" optional="yes" description="Run as Private Capture."/>
      <result type="text" description="JSON automation result."/>
    </command>
    <command name="repeat last capture" code="SSSaREPT" description="Repeat the last repeatable capture.">
      <cocoa class="SSSRepeatLastCaptureCommand"/>
      <parameter name="output" code="SSou" type="text" optional="yes" description="editor, clipboard, float, or none."/>
      <parameter name="outputPath" code="SSop" type="text" optional="yes" description="POSIX output path for rendered file."/>
      <parameter name="format" code="SSfm" type="text" optional="yes" description="png, jpeg, or pdf."/>
      <parameter name="overwrite" code="SSow" type="boolean" optional="yes" description="Replace an existing file."/>
      <result type="text" description="JSON automation result."/>
    </command>
    <command name="open snip document" code="SSSaOPEN" description="Open an editable SnipSnipSnip document.">
      <cocoa class="SSSOpenSnipDocumentCommand"/>
      <parameter name="path" code="SSpa" type="text" description="POSIX path to a .sss document."/>
      <parameter name="output" code="SSou" type="text" optional="yes" description="editor, clipboard, float, or none."/>
      <parameter name="outputPath" code="SSop" type="text" optional="yes" description="POSIX output path for rendered file."/>
      <parameter name="format" code="SSfm" type="text" optional="yes" description="png, jpeg, or pdf."/>
      <parameter name="overwrite" code="SSow" type="boolean" optional="yes" description="Replace an existing file."/>
      <result type="text" description="JSON automation result."/>
    </command>
    <command name="export current screenshot" code="SSSaEXPT" description="Export the current screenshot.">
      <cocoa class="SSSExportCurrentScreenshotCommand"/>
      <parameter name="format" code="SSfm" type="text" optional="yes" description="png, jpeg, or pdf."/>
      <parameter name="output" code="SSou" type="text" optional="yes" description="editor, clipboard, float, or none."/>
      <parameter name="outputPath" code="SSop" type="text" optional="yes" description="POSIX output path for rendered file."/>
      <parameter name="overwrite" code="SSow" type="boolean" optional="yes" description="Replace an existing file."/>
      <result type="text" description="JSON automation result."/>
    </command>
  </suite>
</dictionary>
